alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"HP Outbound shell marker"; flow:established,to_server; content:"/bin/sh"; sid:1000001; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET [4444,5555,1337,9001] (msg:"HP Reverse shell port attempt"; flags:S; threshold:type limit, track by_src, count 1, seconds 60; sid:1000002; rev:1;)
alert tcp $HOME_NET any -> $PROTECTED_NET any (msg:"HP Protected network connection attempt"; flags:S; threshold:type limit, track by_src, count 1, seconds 60; sid:1000003; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"HP Executable HTTP response"; flow:established,to_client; file_data; content:"MZ"; depth:2; sid:1000004; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET [22,2222] (msg:"HP Repeated SSH probing"; flags:S; threshold:type both, track by_src, count 10, seconds 60; sid:1000005; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"HP Scanner HTTP user agent"; flow:established,to_server; http.user_agent; content:"masscan"; nocase; sid:1000006; rev:1;)
alert udp $HOME_NET any -> any 53 (msg:"HP DNS query burst"; threshold:type both, track by_src, count 50, seconds 60; sid:1000007; rev:1;)
alert ip $HOME_NET any -> 169.254.169.254 any (msg:"HP Cloud metadata access attempt"; threshold:type limit, track by_src, count 1, seconds 60; sid:1000008; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 445 (msg:"HP Outbound SMB attempt"; flags:S; threshold:type limit, track by_src, count 1, seconds 60; sid:1000009; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 3389 (msg:"HP Outbound RDP attempt"; flags:S; threshold:type limit, track by_src, count 1, seconds 60; sid:1000010; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"HP Mining protocol subscribe"; flow:established,to_server; content:"mining.subscribe"; sid:1000011; rev:1;)
